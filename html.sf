<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>The Layered Mind - Neural Network</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    overflow: hidden;
    background: #02050b;
    font-family: Arial, sans-serif;
    color: white;
}

/* ================= VIDEO BACKGROUND ================= */

.scene {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background:
        radial-gradient(circle at 70% 45%, rgba(0,180,255,.15), transparent 30%),
        linear-gradient(120deg, #02050b, #07121e);
}

/* Put your student video here later */
.student-video {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .28;
    filter: brightness(.55) contrast(1.1);
}

/* Dark cinematic overlay */
.scene::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.65),
            rgba(0,10,20,.25),
            rgba(0,0,0,.6)
        );
    pointer-events: none;
}

/* ================= CANVAS ================= */

#networkCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
}

/* ================= HOLOGRAM TITLE ================= */

.title-card {
    position: absolute;
    top: 7%;
    left: 50%;
    transform: translateX(-50%);
    width: min(600px, 80%);
    padding: 25px 35px;

    border: 1px solid rgba(80,220,255,.65);
    border-radius: 18px;

    background: rgba(0,30,50,.28);
    backdrop-filter: blur(12px);

    box-shadow:
        0 0 25px rgba(0,200,255,.25),
        inset 0 0 30px rgba(0,200,255,.08);

    z-index: 5;
    text-align: center;
}

.title-card h1 {
    font-size: clamp(28px, 4vw, 52px);
    letter-spacing: 2px;
    color: #bdf5ff;
    text-shadow: 0 0 20px #00d9ff;
}

.title-card p {
    margin-top: 8px;
    font-size: 15px;
    color: #b7d9e5;
}

/* ================= LEFT LESSON PANEL ================= */

.lesson-panel {
    position: absolute;
    left: 4%;
    top: 28%;
    width: 260px;

    padding: 20px;

    border: 1px solid rgba(0,220,255,.45);
    border-radius: 15px;

    background: rgba(0,25,40,.42);
    backdrop-filter: blur(10px);

    box-shadow:
        0 0 25px rgba(0,180,255,.18),
        inset 0 0 20px rgba(0,220,255,.06);

    z-index: 6;
}

.lesson-panel h2 {
    color: #70eaff;
    font-size: 20px;
    margin-bottom: 18px;
}

.step {
    margin: 15px 0;
    padding-left: 10px;
    border-left: 2px solid #00d9ff;
}

.step-number {
    color: #00eaff;
    font-weight: bold;
}

.step-title {
    font-weight: bold;
    margin-left: 6px;
}

.step-text {
    color: #9ab7c4;
    font-size: 12px;
    margin-top: 4px;
}

/* ================= RIGHT PANEL ================= */

.component-panel {
    position: absolute;
    right: 4%;
    top: 28%;
    width: 230px;

    padding: 20px;

    border: 1px solid rgba(100,220,255,.4);
    border-radius: 15px;

    background: rgba(0,25,40,.4);
    backdrop-filter: blur(10px);

    z-index: 6;
}

.component-panel h2 {
    color: #70eaff;
    font-size: 18px;
    margin-bottom: 15px;
}

.component {
    padding: 9px 0;
    color: #b7d9e5;
    font-size: 13px;
}

.component span {
    color: #00eaff;
    margin-right: 7px;
}

/* ================= OUTPUT ================= */

.output-card {
    position: absolute;
    left: 50%;
    bottom: 12%;
    transform: translateX(-50%);

    min-width: 180px;
    padding: 15px 25px;

    text-align: center;

    border: 1px solid rgba(0,240,255,.7);
    border-radius: 15px;

    background: rgba(0,40,60,.45);
    backdrop-filter: blur(10px);

    box-shadow:
        0 0 30px rgba(0,220,255,.3);

    z-index: 7;
}

.output-card small {
    color: #8cb9c6;
}

.output-card h2 {
    margin-top: 4px;
    color: #8ff5ff;
    font-size: 30px;
    text-shadow: 0 0 15px #00eaff;
}

/* ================= FINAL MESSAGE ================= */

.final-message {
    position: absolute;
    bottom: 5%;
    left: 50%;
    transform: translateX(-50%);

    z-index: 10;

    font-size: clamp(15px, 2vw, 25px);
    text-align: center;

    color: white;
    opacity: 0;

    transition: 1s ease;
}

.final-message.show {
    opacity: 1;
}

.final-message strong {
    color: #6fefff;
    text-shadow: 0 0 15px #00d9ff;
}

/* ================= SWIPE BUTTON ================= */

.demo-button {
    position: absolute;
    right: 4%;
    bottom: 7%;

    z-index: 10;

    padding: 12px 18px;

    border: 1px solid #00d9ff;
    border-radius: 10px;

    background: rgba(0,40,60,.5);
    color: #baf7ff;

    cursor: pointer;

    box-shadow: 0 0 15px rgba(0,220,255,.25);
}

.demo-button:hover {
    background: rgba(0,100,130,.5);
}

/* ================= RESPONSIVE ================= */

@media(max-width: 800px) {

    .lesson-panel {
        left: 3%;
        top: 25%;
        width: 190px;
        padding: 12px;
    }

    .component-panel {
        display: none;
    }

    .lesson-panel h2 {
        font-size: 15px;
    }

    .step {
        margin: 9px 0;
    }

    .step-text {
        font-size: 10px;
    }
}
</style>
</head>

<body>

<div class="scene">

    <!-- ========================================= -->
    <!-- REAL STUDENT VIDEO -->
    <!-- Replace student.mp4 with your actual video -->
    <!-- ========================================= -->

    <video
        class="student-video"
        autoplay
        muted
        loop
        playsinline
    >
        <source src="student.mp4" type="video/mp4">
    </video>


    <!-- ================= TITLE ================= -->

    <div class="title-card">

        <h1>Neural Network</h1>

        <p>
            A machine learning model inspired by the human brain
            that learns patterns from data.
        </p>

    </div>


    <!-- ================= LESSON ================= -->

    <div class="lesson-panel">

        <h2>How It Works</h2>

        <div class="step">
            <span class="step-number">01</span>
            <span class="step-title">Input</span>

            <div class="step-text">
                Data enters the neural network.
            </div>
        </div>

        <div class="step">
            <span class="step-number">02</span>
            <span class="step-title">Process</span>

            <div class="step-text">
                Data passes through layers of neurons.
            </div>
        </div>

        <div class="step">
            <span class="step-number">03</span>
            <span class="step-title">Learn</span>

            <div class="step-text">
                Weights adjust based on the data.
            </div>
        </div>

        <div class="step">
            <span class="step-number">04</span>
            <span class="step-title">Predict</span>

            <div class="step-text">
                The network produces an output.
            </div>
        </div>

    </div>


    <!-- ================= COMPONENTS ================= -->

    <div class="component-panel">

        <h2>Key Components</h2>

        <div class="component">
            <span>✦</span>
            Neurons
        </div>

        <div class="component">
            <span>⌁</span>
            Weights
        </div>

        <div class="component">
            <span>◔</span>
            Bias
        </div>

        <div class="component">
            <span>ƒ</span>
            Activation Function
        </div>

    </div>


    <!-- ================= OUTPUT ================= -->

    <div class="output-card">

        <small>NETWORK OUTPUT</small>

        <h2 id="outputText">Cat 98%</h2>

    </div>


    <!-- ================= CANVAS ================= -->

    <canvas id="networkCanvas"></canvas>


    <!-- ================= DEMO ================= -->

    <button class="demo-button" onclick="swipeEffect()">
        ✋ Swipe Information
    </button>


    <!-- ================= FINAL ================= -->

    <div class="final-message" id="finalMessage">

        AI is not replacing the student.<br>

        <strong>It's upgrading the lens.</strong>

    </div>

</div>


<script>

/* =====================================================
   NEURAL NETWORK CANVAS
===================================================== */

const canvas = document.getElementById("networkCanvas");
const ctx = canvas.getContext("2d");

let width;
let height;

function resizeCanvas() {

    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;

}

resizeCanvas();

window.addEventListener("resize", resizeCanvas);


/* =====================================================
   NETWORK LAYERS
===================================================== */

const layerStructure = [
    4,  // Input
    5,  // Hidden
    5,  // Hidden
    1   // Output
];

let nodes = [];
let connections = [];
let particles = [];

let animationTime = 0;


/* =====================================================
   CREATE NODES
===================================================== */

function createNetwork() {

    nodes = [];
    connections = [];

    const startX = width * 0.34;
    const endX = width * 0.68;

    const layerDistance =
        (endX - startX) /
        (layerStructure.length - 1);

    layerStructure.forEach((count, layerIndex) => {

        const x =
            startX +
            layerDistance * layerIndex;

        const verticalSpacing =
            Math.min(70, height * 0.075);

        const totalHeight =
            (count - 1) * verticalSpacing;

        for(let i = 0; i < count; i++) {

            const y =
                height * 0.52 -
                totalHeight / 2 +
                i * verticalSpacing;

            nodes.push({
                x: x,
                y: y,
                layer: layerIndex,
                index: i,
                pulse: Math.random() * Math.PI * 2
            });

        }

    });


    /* =========================================
       CONNECT ADJACENT LAYERS
    ========================================= */

    for(let i = 0; i < nodes.length; i++) {

        const current = nodes[i];

        for(let j = 0; j < nodes.length; j++) {

            const next = nodes[j];

            if(
                next.layer === current.layer + 1
            ) {

                connections.push({
                    from: current,
                    to: next
                });

            }

        }

    }

}

createNetwork();


/* =====================================================
   PARTICLES
===================================================== */

function createParticle() {

    if(connections.length === 0) return;

    const connection =
        connections[
            Math.floor(
                Math.random() *
                connections.length
            )
        ];

    particles.push({

        connection: connection,

        progress: 0,

        speed:
            0.004 +
            Math.random() * 0.006

    });

}


/* =====================================================
   DRAW CONNECTIONS
===================================================== */

function drawConnections() {

    connections.forEach(connection => {

        const a = connection.from;
        const b = connection.to;

        ctx.beginPath();

        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);

        ctx.strokeStyle =
            "rgba(50,220,255,0.16)";

        ctx.lineWidth = 1;

        ctx.stroke();

    });

}


/* =====================================================
   DRAW NODES
===================================================== */

function drawNodes() {

    nodes.forEach(node => {

        node.pulse += 0.04;

        const pulse =
            Math.sin(node.pulse) * 2;

        /* Outer glow */

        const gradient =
            ctx.createRadialGradient(
                node.x,
                node.y,
                1,
                node.x,
                node.y,
                20 + pulse
            );

        gradient.addColorStop(
            0,
            "rgba(100,240,255,0.9)"
        );

        gradient.addColorStop(
            0.3,
            "rgba(0,180,255,0.35)"
        );

        gradient.addColorStop(
            1,
            "rgba(0,180,255,0)"
        );

        ctx.beginPath();

        ctx.arc(
            node.x,
            node.y,
            20 + pulse,
            0,
            Math.PI * 2
        );

        ctx.fillStyle = gradient;

        ctx.fill();


        /* Core */

        ctx.beginPath();

        ctx.arc(
            node.x,
            node.y,
            7,
            0,
            Math.PI * 2
        );

        ctx.fillStyle =
            "#bafaff";

        ctx.shadowBlur = 20;
        ctx.shadowColor = "#00eaff";

        ctx.fill();

        ctx.shadowBlur = 0;

    });

}


/* =====================================================
   DRAW PARTICLES
===================================================== */

function drawParticles() {

    particles.forEach((particle, index) => {

        particle.progress +=
            particle.speed;

        const a =
            particle.connection.from;

        const b =
            particle.connection.to;

        const x =
            a.x +
            (b.x - a.x) *
            particle.progress;

        const y =
            a.y +
            (b.y - a.y) *
            particle.progress;


        /* Particle glow */

        ctx.beginPath();

        ctx.arc(
            x,
            y,
            5,
            0,
            Math.PI * 2
        );

        ctx.fillStyle =
            "#ffffff";

        ctx.shadowBlur = 20;
        ctx.shadowColor = "#00eaff";

        ctx.fill();

        ctx.shadowBlur = 0;


        if(particle.progress >= 1) {

            particles.splice(index, 1);

        }

    });

}


/* =====================================================
   LAYER LABELS
===================================================== */

function drawLabels() {

    ctx.font =
        "bold 14px Arial";

    ctx.textAlign =
        "center";

    ctx.fillStyle =
        "rgba(160,240,255,.8)";


    const labels = [
        "INPUT",
        "HIDDEN",
        "HIDDEN",
        "OUTPUT"
    ];


    layerStructure.forEach(
        (count, layerIndex) => {

            const layerNodes =
                nodes.filter(
                    n => n.layer === layerIndex
                );

            if(layerNodes.length === 0)
                return;

            const x =
                layerNodes[0].x;

            const y =
                Math.min(
                    ...layerNodes.map(n => n.y)
                ) - 45;

            ctx.fillText(
                labels[layerIndex],
                x,
                y
            );

        }
    );

}


/* =====================================================
   ANIMATION
===================================================== */

function animate() {

    ctx.clearRect(
        0,
        0,
        width,
        height
    );

    animationTime += 0.01;


    drawConnections();

    drawParticles();

    drawNodes();

    drawLabels();


    /* Random data movement */

    if(Math.random() < 0.08) {

        createParticle();

    }


    requestAnimationFrame(animate);

}

animate();


/* =====================================================
   SWIPE EFFECT
===================================================== */

function swipeEffect() {

    const button =
        document.querySelector(".demo-button");

    button.innerText =
        "⚡ Processing...";


    /* Move network */

    nodes.forEach(node => {

        node.x +=
            (Math.random() - 0.5) * 120;

        node.y +=
            (Math.random() - 0.5) * 80;

    });


    document.getElementById(
        "outputText"
    ).innerText =
        "AI Learned!";


    setTimeout(() => {

        document.getElementById(
            "outputText"
        ).innerText =
            "Cat 98%";

        document.getElementById(
            "finalMessage"
        ).classList.add("show");

        button.innerText =
            "✋ Swipe Again";

    }, 2200);

}


/* =====================================================
   KEYBOARD DEMO
   Press SPACE = Swipe
===================================================== */

document.addEventListener(
    "keydown",
    event => {

        if(event.code === "Space") {

            swipeEffect();

        }

    }
);

</script>

</body>
</html>